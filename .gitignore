# ── Build artifacts ─────────────────────────────────────────────────────────
/build/
*.o
*.obj
*.a

# Host test binaries (built in-tree by the README / manual gcc commands)
/test_host
/test_engine_*
/test_confidence
*.out

# ── Generated model artifacts — may embed weights; do not commit ────────────
weights.c
weights.h
weights_debug.npz
calib.npz

# ── Secrets — device keys. NEVER commit. ────────────────────────────────────
secrets.h
key.bin
*.key
*.pem

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── OS ──────────────────────────────────────────────────────────────────────
.DS_Store

# ── Claude Code / tooling session transcripts ───────────────────────────────
# Timestamped session dumps (YYYY-MM-DD-HHMMSS-*.txt) may embed conversation
# history, emails, or keys. Never commit them; keep them out of the working
# tree's staging surface. Delete the local copies when you no longer need them.
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# AVR example build artifacts
*.elf
*.hex
