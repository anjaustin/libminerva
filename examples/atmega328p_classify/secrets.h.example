/**
 * secrets.h.example — template for the device-key header.
 *
 * Copy to `secrets.h` (git-ignored — never commit a real key). The generated
 * weights.c references MNV_DEVICE_KEY for the model descriptor's `.key` field,
 * so this macro must be defined for the build to link. There are two modes:
 *
 *  ┌────────────────────────────────────────────────────────────────────────┐
 *  │ PRODUCTION (default below): MNV_DEVICE_KEY is a 32-byte ZERO PLACEHOLDER.│
 *  │ The real key is provisioned to EEPROM behind a lock fuse and loaded into │
 *  │ RAM at boot; main.c overrides model.key with that buffer, so the real    │
 *  │ key is NEVER in the firmware image. This is the pattern the threat model │
 *  │ (§6) recommends. Provision the key with, e.g.:                           │
 *  │     avrdude -p atmega328p -c arduino -U eeprom:w:key.bin:r                │
 *  └────────────────────────────────────────────────────────────────────────┘
 *
 *  ┌────────────────────────────────────────────────────────────────────────┐
 *  │ DEVELOPMENT ONLY (the commented block): compile the real key straight    │
 *  │ into flash. Convenient, but the key is recoverable by ANY flash/JTAG     │
 *  │ dump — this gives weight *integrity* but NOT weight *confidentiality*.   │
 *  │ Do not ship it. If you use this, main.c's EEPROM override is a no-op     │
 *  │ only if you also point model.key back at MNV_DEVICE_KEY.                 │
 *  └────────────────────────────────────────────────────────────────────────┘
 */
#ifndef MNV_SECRETS_H
#define MNV_SECRETS_H
#include <stdint.h>

/* PRODUCTION: zero placeholder — the real key is loaded from EEPROM at runtime
 * (see main.c). The compiled-in value is unused. */
static const uint8_t mnv_device_key_placeholder[32] = { 0 };
#define MNV_DEVICE_KEY  mnv_device_key_placeholder

/* DEVELOPMENT ONLY — key compiled into flash. Uncomment and paste your 32 bytes
 * (from `minerva_compile.py --gen-key`), and remove the placeholder above.
 * WARNING: recoverable by any flash dump. Never ship this.
 *
 * static const uint8_t mnv_device_key_dev[32] = {
 *     0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
 *     0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF,
 *     0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
 *     0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF,
 * };
 * #define MNV_DEVICE_KEY  mnv_device_key_dev
 */

#endif /* MNV_SECRETS_H */
